USE olist_dataset;
GO

--creating schema 

IF NOT EXISTS(SELECT * FROM sys.schemas WHERE name = 'bronze')
BEGIN
	EXEC('CREATE SCHEMA bronze');
	PRINT 'Created bronze schema';
END
ELSE
BEGIN
	PRINT 'Schema bronze already exists - skipped.';
END
GO

