---create table 
IF OBJECT_ID('bronze.order_data', 'U') IS NOT NULL
	DROP TABLE bronze.order_data;
GO

CREATE TABLE bronze.order_data(
	order_id	VARCHAR(50),
	customer_id	VARCHAR(50),
	order_status VARCHAR(30),	
	order_purchase_timestamp VARCHAR(30),	
	order_approved_at VARCHAR(30),	
	order_delivered_carrier_date VARCHAR(30),	
	order_delivered_customer_date VARCHAR(30),	
	order_estimated_delivery_date VARCHAR(30)	
)

SELECT 
	COLUMN_NAME,
	DATA_TYPE,
	CHARACTER_MAXIMUM_LENGTH
FROM INFORMATION_SCHEMA.COLUMNS
WHERE TABLE_SCHEMA = 'bronze'
	AND TABLE_NAME = 'order_data'
ORDER BY ORDINAL_POSITION;


==========================================================
OUTPUT

COLUMN_NAME	DATA_TYPE	CHARACTER_MAXIMUM_LENGTH
order_id	varchar	50
customer_id	varchar	50
order_status	varchar	30
order_purchase_timestamp	varchar	30
order_approved_at	varchar	30
order_delivered_carrier_date	varchar	30
order_delivered_customer_date	varchar	30
order_estimated_delivery_date	varchar	30

