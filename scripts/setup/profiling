USE olist_dataset;
GO

-- 1) order_id uniqueness
SELECT COUNT(*) AS total_rows,
       COUNT(DISTINCT order_id) AS distinct_order_id
FROM bronze.order_data;                       -- expect both 99441

-- 2) Duplicate order_id
SELECT order_id, COUNT(*) AS cnt
FROM bronze.order_data
GROUP BY order_id
HAVING COUNT(*) > 1;                          -- expect 0 rows

-- 3) Status distribution
SELECT order_status,
       COUNT(*) AS total_orders,
       CAST(COUNT(*) * 100.0 / SUM(COUNT(*)) OVER () AS DECIMAL(5,2)) AS pct_of_total
FROM bronze.order_data
GROUP BY order_status
ORDER BY total_orders DESC;                   -- delivered ~97%

-- 4) Missing delivery dates by status
SELECT order_status, COUNT(*) AS no_customer_date
FROM bronze.order_data
WHERE order_delivered_customer_date IS NULL
GROUP BY order_status;                        -- delivered = 8 is a finding

SELECT order_status, COUNT(*) AS no_carrier_date
FROM bronze.order_data
WHERE order_delivered_carrier_date IS NULL
GROUP BY order_status;                        -- delivered = 2 is a finding

-- 5) Blank strings (not true NULLs)
SELECT COUNT(*) AS blank_dates
FROM bronze.order_data
WHERE order_delivered_customer_date = ''
   OR order_delivered_carrier_date  = ''
   OR order_approved_at             = '';     -- expect 0

-- 6) Canceled orders that have a delivery date
SELECT COUNT(*) AS canceled_with_delivery
FROM bronze.order_data
WHERE order_status = 'canceled'
  AND order_delivered_customer_date IS NOT NULL;   -- found 6

-- 7) Date format check (dd-mm-yyyy, style 105)
SELECT
  SUM(CASE WHEN order_purchase_timestamp      IS NOT NULL AND TRY_CONVERT(DATETIME2, order_purchase_timestamp,      105) IS NULL THEN 1 ELSE 0 END) AS bad_purchase,
  SUM(CASE WHEN order_approved_at             IS NOT NULL AND TRY_CONVERT(DATETIME2, order_approved_at,             105) IS NULL THEN 1 ELSE 0 END) AS bad_approved,
  SUM(CASE WHEN order_delivered_carrier_date  IS NOT NULL AND TRY_CONVERT(DATETIME2, order_delivered_carrier_date,  105) IS NULL THEN 1 ELSE 0 END) AS bad_carrier,
  SUM(CASE WHEN order_delivered_customer_date IS NOT NULL AND TRY_CONVERT(DATETIME2, order_delivered_customer_date, 105) IS NULL THEN 1 ELSE 0 END) AS bad_customer,
  SUM(CASE WHEN order_estimated_delivery_date IS NOT NULL AND TRY_CONVERT(DATETIME2, order_estimated_delivery_date, 105) IS NULL THEN 1 ELSE 0 END) AS bad_estimated
FROM bronze.order_data;                       -- expect 0 in each

-- 8) Carrier date before purchase date
SELECT COUNT(*) AS carrier_before_purchase
FROM bronze.order_data
WHERE TRY_CONVERT(DATETIME2, order_delivered_carrier_date, 105)
    < TRY_CONVERT(DATETIME2, order_purchase_timestamp,     105);

-- 9) Orphan reviews (review with no parent order)
SELECT COUNT(*) AS orphan_reviews
FROM bronze.order_reviews_data r
LEFT JOIN bronze.order_data o ON o.order_id = r.order_id
WHERE o.order_id IS NULL;                     -- expect 0
